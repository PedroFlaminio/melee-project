static void* yakumono_kraid(MeleeHostHsdReader* reader, mh_u32 root)
{
    struct melee_host_yakumono_kraid* out = melee_host_hsd_reader_allocate(
        reader, sizeof(*out), _Alignof(struct melee_host_yakumono_kraid));
    mh_u32 target;

    if (out == NULL) {
        return NULL;
    }
    (void) target;
    /* The block on disc has to be the size this layout describes;
     * a mismatch means the stage's struct moved under the
     * generator, not that the data is unusual. */
    if (melee_host_hsd_reader_extent(reader, root) != 0x34) {
        melee_host_hsd_reader_fail(
            reader, "Kraid yakumono_param is not 0x34 bytes");
        return NULL;
    }
    out->map_time_min = melee_host_hsd_reader_u32(reader, root + 0x0);
    out->map_time_max = melee_host_hsd_reader_u32(reader, root + 0x4);
    out->map_time_acl = (mh_s32) melee_host_hsd_reader_u32(reader, root + 0x8);
    out->map_rot_spd_min = melee_host_hsd_reader_f32(reader, root + 0xC);
    out->map_rot_spd_max = melee_host_hsd_reader_f32(reader, root + 0x10);
    out->kraid_wait_time = melee_host_hsd_reader_u32(reader, root + 0x14);
    out->kraid_wait_time_add = melee_host_hsd_reader_u32(reader, root + 0x18);
    out->kraid_pos_x[0] = melee_host_hsd_reader_f32(reader, root + 0x1C);
    out->kraid_pos_x[1] = melee_host_hsd_reader_f32(reader, root + 0x20);
