static void* yakumono_battle(MeleeHostHsdReader* reader, mh_u32 root)
{
    struct melee_host_yakumono_battle* out = melee_host_hsd_reader_allocate(
        reader, sizeof(*out), _Alignof(struct melee_host_yakumono_battle));
    mh_u32 target;

    if (out == NULL) {
        return NULL;
    }
    (void) target;
    /* The block on disc has to be the size this layout describes;
     * a mismatch means the stage's struct moved under the
     * generator, not that the data is unusual. */
    if (melee_host_hsd_reader_extent(reader, root) != 0x8) {
        melee_host_hsd_reader_fail(
            reader, "Battle yakumono_param is not 0x8 bytes");
        return NULL;
    }
    if (melee_host_hsd_reader_pointer(reader, root + 0x0, &target)) {
        out->bg_curr_color_overlay =
            melee_host_hsd_reader_command_stream(reader, target);
    } else {
        out->bg_curr_color_overlay = NULL;
    }
    if (melee_host_hsd_reader_pointer(reader, root + 0x4, &target)) {
        out->bg_prev_color_overlay =
            melee_host_hsd_reader_command_stream(reader, target);
    } else {
        out->bg_prev_color_overlay = NULL;
    }
    return melee_host_hsd_reader_failed(reader) ? NULL : out;
}

