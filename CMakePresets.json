{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Native host debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MELEE_HOST_BUILD_TESTS": "ON",
        "MELEE_HOST_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "host-sanitize",
      "displayName": "Native host with ASan and UBSan",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build/host-sanitize",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "MELEE_HOST_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "host-release",
      "displayName": "Native host release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MELEE_HOST_BUILD_TESTS": "OFF",
        "MELEE_HOST_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "host-debug-windows",
      "displayName": "Native host debug (Clang on Visual Studio)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-debug-windows",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
        "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
        "CMAKE_MAKE_PROGRAM": "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe",
        "CMAKE_BUILD_TYPE": "Debug",
        "MELEE_HOST_BUILD_TESTS": "ON",
        "MELEE_HOST_WARNINGS_AS_ERRORS": "OFF",
        "MELEE_HOST_BUILD_SDL_RENDERER": "ON"
      }
    },
    {
      "name": "host-release-windows",
      "displayName": "Native host release (Clang on Visual Studio)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-release-windows",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
        "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
        "CMAKE_MAKE_PROGRAM": "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe",
        "CMAKE_BUILD_TYPE": "Release",
        "MELEE_HOST_BUILD_TESTS": "OFF",
        "MELEE_HOST_WARNINGS_AS_ERRORS": "OFF",
        "MELEE_HOST_BUILD_SDL_RENDERER": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-sanitize",
      "configurePreset": "host-sanitize"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release"
    },
    {
      "name": "host-debug-windows",
      "configurePreset": "host-debug-windows",
      "configuration": "Debug"
    },
    {
      "name": "host-release-windows",
      "configurePreset": "host-release-windows",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-sanitize",
      "configurePreset": "host-sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-debug-windows",
      "configurePreset": "host-debug-windows",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

